# ==========================================
# ZEYNEPNOVA E-TİCARET SİSTEMİ ORTAM DEĞİŞKENLERİ
# ==========================================

# 1. TEMEL UYGULAMA AYARLARI
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=ZeynepNova
NEXT_PUBLIC_CURRENCY=TRY
NEXT_PUBLIC_CURRENCY_SYMBOL=₺
NEXT_PUBLIC_LOCALE=tr-TR
NEXT_PUBLIC_TIMEZONE=Europe/Istanbul

# 2. VERİTABANI AYARLARI (PostgreSQL / Supabase)
# Canlı Supabase veya doğrudan PostgreSQL bağlantı dizesi
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zeynepnova
# Supabase Transaction Pooler (Varsa)
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/zeynepnova

# 3. SUPABASE KİMLİK DOĞRULAMA VE DEPOLAMA (AUTH & STORAGE)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=product-images

# 4. İYZİCO ÖDEME SİSTEMİ AYARLARI
# Sandbox test modu: https://sandbox-api.iyzipay.com
# Canlı üretim modu: https://api.iyzipay.com
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_API_KEY=sandbox-api-key
IYZICO_SECRET_KEY=sandbox-secret-key
IYZICO_CALLBACK_URL=http://localhost:3000/api/payments/iyzico/callback

# 5. E-POSTA VE BİLDİRİM AYARLARI (SMTP)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=your-smtp-api-key
EMAIL_FROM=ZeynepNova Takı <bilgi@zeynepnova.com>
EMAIL_SUPPORT=destek@zeynepnova.com

# 6. KARGO VE SİPARİŞ KURAL AYARLARI
# Bu tutarın üzerindeki siparişlerde kargo ücretsiz olur (TL)
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=1500
# Standart sabit kargo ücreti (TL)
NEXT_PUBLIC_STANDARD_SHIPPING_FEE=79.90

# 7. İLK YÖNETİCİ KURULUMU GÜVENLİK AYARLARI
INITIAL_ADMIN_EMAIL=admin@zeynepnova.com
ADMIN_SETUP_SECRET=change-this-to-a-secure-random-secret
